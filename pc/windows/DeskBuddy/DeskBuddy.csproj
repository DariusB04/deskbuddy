<Project Sdk="Microsoft.NET.Sdk">

  <!-- DeskBuddy pentru Windows: aplicație în tray care trimite temperaturile PC-ului și starea Claude Code la DeskBuddy (UDP 4210).
       Build:  dotnet publish -c Release -o ..   ->  pc\windows\DeskBuddy.exe -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+: API-ul WinRT pentru ce se redă (Windows.Media.Control) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeskBuddy</AssemblyName>
    <RootNamespace>DeskBuddy</RootNamespace>
    <!-- la release, GitHub Actions dă -p:Version=<tag> și -p:GitHubRepo=<owner/repo> -->
    <Version>2.4.0</Version>
    <GitHubRepo Condition="'$(GitHubRepo)' == ''"></GitHubRepo>
    <Product>DeskBuddy</Product>
    <!-- aceeași iconiță ca în tray; regenerată cu: DeskBuddy.exe make-icon DeskBuddy.ico -->
    <ApplicationIcon>DeskBuddy.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- un singur .exe care nu cere .NET instalat (~107 MB). Comprimat ar avea 49 MB, dar ia dublu RAM (85 vs 41 MB privat)
         și pornește hook-urile în 140 ms în loc de 65 ms: pentru o aplicație mereu pornită contează mai mult memoria.
         Varianta mică (4.8 MB): dotnet publish -c Release -o .. -p:SelfContained=false, dar cere .NET 10 Desktop Runtime instalat. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- citește senzorii direct (fără LibreHardwareMonitor pornit separat); temperatura CPU cere admin + driverul PawnIO -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- legătura prin USB: datele și flash-ul firmware-ului -->
    <PackageReference Include="System.IO.Ports" Version="10.0.3" />
    <!-- FPS-ul jocurilor: evenimentele ETW „Present” (DXGI / D3D9), ca PresentMon -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
  </ItemGroup>

  <ItemGroup>
    <!-- de unde verifică aplicația update-urile (gol = nu verifică) -->
    <AssemblyMetadata Include="GitHubRepo" Value="$(GitHubRepo)" />
  </ItemGroup>


</Project>
